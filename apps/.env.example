# 复制为 apps/.env 后填写真实值。本文件只保留占位符，不要提交密钥。

# --- 数据库 ---
DB_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/agent

# --- JWT / 登录 ---
# 私钥/公钥默认在 apps/api/.keys/ 下；也可用绝对路径覆盖。
JWT_ISSUER=computer-network-agent
JWT_AUDIENCE=agent
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800

# 跨域来源（同源反代时留空；逗号分隔）
CORS_ORIGINS=

# --- 模型 ---
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Langfuse ---
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- AGS 沙盒 ---
E2B_DOMAIN=replace-me
E2B_API_KEY=replace-me
AGS_TOOL_NAME=replace-me
AGS_SANDBOX_TIMEOUT_SECONDS=300
