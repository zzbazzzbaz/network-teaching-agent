LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_BASE_URL=https://langfuse.gqt.plus
# 可选：trace 的 environment / release 维度，需在进程启动前设置
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=local-dev

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

E2B_DOMAIN=ap-shanghai.tencentags.com
E2B_API_KEY=sk-xxx

AGS_TOOL_NAME=network-teaching-agent-sandbox
AGS_SANDBOX_TIMEOUT_SECONDS=3600
AGS_SANDBOX_IDLE_SECONDS=1800
AGS_SANDBOX_PAUSED_RETENTION_SECONDS=86400
AGS_SANDBOX_MAX_LIFETIME_SECONDS=604800
AGS_SANDBOX_HEARTBEAT_SECONDS=300

DB_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent?sslmode=disable

JWT_PRIVATE_KEY_PATH=.keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt_public.pem
JWT_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json

CORS_ORIGINS=

AGENT_URL=http://127.0.0.1:2024
API_URL=http://127.0.0.1:8000
