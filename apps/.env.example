# 复制为 apps/.env 后填写真实值。本文件只保留占位符，不要提交密钥。
# 前端（agent-ui）也读取本文件，AGENT_URL / API_URL / UI_PORT 等必须配置。

# --- 数据库 ---
DB_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/agent

# --- JWT / 登录 ---
# 私钥/公钥路径；相对路径以 apps/api 为基准，也可用绝对路径覆盖。
JWT_PRIVATE_KEY_PATH=.keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt_public.pem
JWT_ISSUER=computer-network-agent
JWT_AUDIENCE=agent
JWT_ACCESS_TOKEN_TTL_SECONDS=1800
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
# Agent 验签用的平台 JWKS 地址
JWT_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json

# 跨域来源（同源反代时留空；逗号分隔）
CORS_ORIGINS=

# --- 模型 ---
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Langfuse ---
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- AGS 沙盒 ---
E2B_DOMAIN=replace-me
E2B_API_KEY=replace-me
AGS_TOOL_NAME=replace-me
AGS_SANDBOX_TIMEOUT_SECONDS=300

# --- 前端 agent-ui ---
AGENT_URL=http://127.0.0.1:2024
API_URL=http://127.0.0.1:8000
UI_PORT=5173

# --- 前端 E2E ---
E2E_APP_URL=http://localhost:5174
E2E_STUDENT_USERNAME=e2e_student
E2E_STUDENT_PASSWORD=replace-me
E2E_OTHER_USERNAME=e2e_other
E2E_OTHER_PASSWORD=replace-me
