# 唯一配置样板：本地开发、CI 构建、生产部署都以本文件为基准。
# 生产服务器 `/srv/network-teaching-agent/.env` = 复制本文件后填写真实密钥，
# 不再单独维护第二套生产配置；deploy/docker-compose.yml 只覆盖容器内的主机名/路径。
# 本地：cp apps/.env.example apps/.env

# ===== Langfuse 可观测性 =====
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_BASE_URL=https://langfuse.gqt.plus
# 环境/版本维度，需在进程启动前设置；生产 compose 会覆盖为 production + TAG
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=local-dev

# ===== DeepSeek =====
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== AGS 沙箱 =====
E2B_DOMAIN=ap-shanghai.tencentags.com
E2B_API_KEY=sk-xxx

AGS_TOOL_NAME=network-teaching-agent-sandbox
AGS_SANDBOX_TIMEOUT_SECONDS=3600
AGS_SANDBOX_IDLE_SECONDS=1800
AGS_SANDBOX_PAUSED_RETENTION_SECONDS=86400
AGS_SANDBOX_MAX_LIFETIME_SECONDS=604800
AGS_SANDBOX_HEARTBEAT_SECONDS=300

# ===== 数据库 =====
# 本地 dev compose 与生产 compose 共用这组凭据；生产 .env 不要另生成一套。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent
# LangGraph Server 专用 pgvector 库（与业务库隔离）
LANGGRAPH_PG_PASSWORD=postgres
# 本地 API 直连 localhost；生产 compose 会用 POSTGRES_* 拼内网地址覆盖本项。
# 改 POSTGRES_PASSWORD 时记得同步改这里。
DB_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent?sslmode=disable

# ===== JWT =====
# 本地相对 apps/api；生产 compose 覆盖为 /app/.keys/...
JWT_PRIVATE_KEY_PATH=.keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt_public.pem
# 本地 Agent 直连 API；生产 compose 覆盖为 http://api:8000/...
JWT_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json

# ===== 前端 =====
# 生产同源部署不需要 CORS；compose 会用 SITE_DOMAIN 生成 https 来源
CORS_ORIGINS=
AGENT_URL=http://127.0.0.1:2024
API_URL=http://127.0.0.1:8000

# ===== 部署（deploy/docker-compose.yml 使用；本地开发忽略）=====
SITE_DOMAIN=network-agent.test.chatgqt.top
WEB_IMAGE=ghcr.io/zzbazzzbaz/network-teaching-agent/web
API_IMAGE=ghcr.io/zzbazzzbaz/network-teaching-agent/api
AGENT_IMAGE=ghcr.io/zzbazzzbaz/network-teaching-agent/agent
