{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 120000,
      "catalog": 60000
    },
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.12.0",
          "--categoryExperimentalThirdParty=true"
        ]
      }
    }
  }
}
